# What the .vsix leaves out; server/, debugger/, testbridge/out/ and hotreload-extension/out/ go in. The code is dist/extension.js, one bundle of the
# sources and node_modules (npm run bundle, before vsce packages), so neither goes in as files.
*.js
node_modules/**
.github/**
# CSharpShooter SQL, an extension of its own (sql/, its own .vsix).
sql/**
testbridge/*.cs
testbridge/*.csproj
testbridge/bin/**
testbridge/obj/**
hotreload-extension/*.cs
hotreload-extension/*.csproj
hotreload-extension/bin/**
hotreload-extension/obj/**
test/**
scripts/**
debugger-port/**
.gitignore
.vscode-test/**
*.vsix
**/*.pdb
