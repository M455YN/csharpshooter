{
  "name": "csharpshooter",
  "displayName": "CSharpShooter",
  "description": "C# and Razor (.cshtml/.razor) for VSCodium from Microsoft's roslyn-language-server.",
  "version": "0.0.1",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "workspaceContains:**/*.sln",
    "workspaceContains:**/*.slnx",
    "workspaceContains:**/*.csproj",
    "onLanguage:csharp",
    "onLanguage:razor",
    "onLanguage:aspnetcorerazor",
    "onDebugResolve:csharpshooter"
  ],
  "contributes": {
    "configuration": {
      "title": "CSharpShooter",
      "properties": {
        "csharpShooter.solution": {
          "type": "string",
          "default": "",
          "description": "Solution (.sln/.slnx) to load. Empty: the first one found in the workspace."
        },
        "csharpShooter.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to Microsoft.CodeAnalysis.LanguageServer.dll. Empty: the one under the extension's server/ folder."
        },
        "csharpShooter.debuggerPath": {
          "type": "string",
          "default": "",
          "description": "Path to the debug adapter (Passenger.DebugAdapter(.exe)). Empty: the one under the extension's debugger/ folder."
        },
        "csharpShooter.razorViewsInDesignTime": {
          "type": "boolean",
          "default": true,
          "description": "Give the language server's Razor every .cshtml even when a project sets RazorCompileOnBuild=false (only the server's design-time builds change; your builds don't)."
        }
      }
    },
    "commands": [
      {
        "command": "csharpShooter.restartServer",
        "title": "Restart C# Language Server",
        "category": "CSharpShooter"
      }
    ],
    "breakpoints": [
      {
        "language": "csharp"
      },
      {
        "language": "razor"
      },
      {
        "language": "aspnetcorerazor"
      }
    ],
    "debuggers": [
      {
        "type": "csharpshooter",
        "label": ".NET (CSharpShooter)",
        "languages": [
          "csharp",
          "razor",
          "aspnetcorerazor"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "The app's .dll or apphost .exe."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "cwd": {
                "type": "string",
                "default": "${workspaceFolder}"
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "default": {}
              },
              "stopAtEntry": {
                "type": "boolean",
                "default": false
              },
              "justMyCode": {
                "type": "boolean",
                "default": true
              },
              "console": {
                "enum": [
                  "internalConsole",
                  "integratedTerminal",
                  "externalTerminal"
                ],
                "default": "internalConsole"
              },
              "hotReload": {
                "type": "boolean",
                "default": false
              }
            }
          },
          "attach": {
            "required": [
              "processId"
            ],
            "properties": {
              "processId": {
                "type": [
                  "integer",
                  "string"
                ],
                "default": "${command:pickProcess}"
              },
              "justMyCode": {
                "type": "boolean",
                "default": true
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "name": "Launch (CSharpShooter)",
            "type": "csharpshooter",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/bin/Debug/net10.0/App.dll",
            "cwd": "${workspaceFolder}"
          }
        ]
      }
    ]
  },
  "scripts": {
    "fetch-server": "node scripts/fetch-server.js",
    "test": "node test/runTest.js"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/test-electron": "^2.4.1"
  }
}
