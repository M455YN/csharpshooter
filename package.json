{
  "name": "csharpshooter",
  "displayName": "CSharpShooter",
  "description": "C# and Razor (.cshtml/.razor) for VSCodium from Microsoft's roslyn-language-server.",
  "version": "0.0.1",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "workspaceContains:**/*.sln",
    "workspaceContains:**/*.slnx",
    "workspaceContains:**/*.csproj",
    "onLanguage:csharp",
    "onLanguage:razor",
    "onLanguage:aspnetcorerazor",
    "onDebugResolve:csharpshooter"
  ],
  "contributes": {
    "configuration": {
      "title": "CSharpShooter",
      "properties": {
        "csharpShooter.solution": {
          "type": "string",
          "default": "",
          "description": "Solution (.sln/.slnx) to load. Empty: the first one found in the workspace."
        },
        "csharpShooter.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to Microsoft.CodeAnalysis.LanguageServer.dll. Empty: the one under the extension's server/ folder."
        },
        "csharpShooter.debuggerPath": {
          "type": "string",
          "default": "",
          "description": "Path to the debug adapter (Passenger.DebugAdapter(.exe)). Empty: the one under the extension's debugger/ folder."
        },
        "csharpShooter.razorViewsInDesignTime": {
          "type": "boolean",
          "default": true,
          "description": "Give the language server's Razor every .cshtml even when a project sets RazorCompileOnBuild=false (only the server's design-time builds change; your builds don't)."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "csharpShooter.solution",
          "name": "Solution",
          "icon": "$(project)"
        }
      ]
    },
    "commands": [
      {
        "command": "csharpShooter.restartServer",
        "title": "Restart C# Language Server",
        "category": "CSharpShooter"
      },
      {
        "command": "csharpShooter.solution.refresh",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "Solution"
      },
      {
        "command": "csharpShooter.solution.syncWithActive",
        "title": "Sync with Active Document",
        "icon": "$(target)",
        "category": "Solution"
      },
      {
        "command": "csharpShooter.solution.build",
        "title": "Build",
        "category": "Solution"
      },
      {
        "command": "csharpShooter.solution.rebuild",
        "title": "Rebuild",
        "category": "Solution"
      },
      {
        "command": "csharpShooter.solution.clean",
        "title": "Clean",
        "category": "Solution"
      },
      {
        "command": "csharpShooter.solution.editProject",
        "title": "Edit Project File",
        "category": "Solution"
      },
      {
        "command": "csharpShooter.solution.revealInOS",
        "title": "Open Folder in File Explorer",
        "category": "Solution"
      },
      {
        "command": "csharpShooter.solution.copyPath",
        "title": "Copy Full Path",
        "category": "Solution"
      },
      {
        "command": "csharpShooter.solution.openInTerminal",
        "title": "Open in Terminal",
        "category": "Solution"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "csharpShooter.solution.syncWithActive",
          "when": "view == csharpShooter.solution",
          "group": "navigation@1"
        },
        {
          "command": "csharpShooter.solution.refresh",
          "when": "view == csharpShooter.solution",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "csharpShooter.solution.build",
          "when": "view == csharpShooter.solution && viewItem =~ /^(solution|project)$/",
          "group": "1_build@1"
        },
        {
          "command": "csharpShooter.solution.rebuild",
          "when": "view == csharpShooter.solution && viewItem =~ /^(solution|project)$/",
          "group": "1_build@2"
        },
        {
          "command": "csharpShooter.solution.clean",
          "when": "view == csharpShooter.solution && viewItem =~ /^(solution|project)$/",
          "group": "1_build@3"
        },
        {
          "command": "csharpShooter.solution.editProject",
          "when": "view == csharpShooter.solution && viewItem == project",
          "group": "2_edit@1"
        },
        {
          "command": "csharpShooter.solution.openInTerminal",
          "when": "view == csharpShooter.solution && viewItem =~ /^(solution|project|folder|file)$/",
          "group": "3_open@1"
        },
        {
          "command": "csharpShooter.solution.revealInOS",
          "when": "view == csharpShooter.solution && viewItem =~ /^(solution|project|folder|file)$/",
          "group": "3_open@2"
        },
        {
          "command": "csharpShooter.solution.copyPath",
          "when": "view == csharpShooter.solution && viewItem =~ /^(solution|project|folder|file)$/",
          "group": "4_copy@1"
        }
      ],
      "commandPalette": [
        {
          "command": "csharpShooter.solution.build",
          "when": "false"
        },
        {
          "command": "csharpShooter.solution.rebuild",
          "when": "false"
        },
        {
          "command": "csharpShooter.solution.clean",
          "when": "false"
        },
        {
          "command": "csharpShooter.solution.editProject",
          "when": "false"
        },
        {
          "command": "csharpShooter.solution.revealInOS",
          "when": "false"
        },
        {
          "command": "csharpShooter.solution.copyPath",
          "when": "false"
        },
        {
          "command": "csharpShooter.solution.openInTerminal",
          "when": "false"
        }
      ]
    },
    "breakpoints": [
      {
        "language": "csharp"
      },
      {
        "language": "razor"
      },
      {
        "language": "aspnetcorerazor"
      }
    ],
    "debuggers": [
      {
        "type": "csharpshooter",
        "label": ".NET (CSharpShooter)",
        "languages": [
          "csharp",
          "razor",
          "aspnetcorerazor"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "The app's .dll or apphost .exe."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "cwd": {
                "type": "string",
                "default": "${workspaceFolder}"
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "default": {}
              },
              "stopAtEntry": {
                "type": "boolean",
                "default": false
              },
              "justMyCode": {
                "type": "boolean",
                "default": true
              },
              "console": {
                "enum": [
                  "internalConsole",
                  "integratedTerminal",
                  "externalTerminal"
                ],
                "default": "internalConsole"
              },
              "hotReload": {
                "type": "boolean",
                "default": false
              }
            }
          },
          "attach": {
            "required": [
              "processId"
            ],
            "properties": {
              "processId": {
                "type": [
                  "integer",
                  "string"
                ],
                "default": "${command:pickProcess}"
              },
              "justMyCode": {
                "type": "boolean",
                "default": true
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "name": "Launch (CSharpShooter)",
            "type": "csharpshooter",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/bin/Debug/net10.0/App.dll",
            "cwd": "${workspaceFolder}"
          }
        ]
      }
    ]
  },
  "scripts": {
    "fetch-server": "node scripts/fetch-server.js",
    "test": "node test/runTest.js"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/test-electron": "^2.4.1"
  }
}
