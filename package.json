{
  "name": "csharpshooter",
  "displayName": "CSharpShooter",
  "description": "C# and Razor (.cshtml/.razor) for VSCodium: IntelliSense, go to definition and tag helpers from Microsoft's roslyn-language-server, a Solution Explorer, F5 on launch profiles, and a bundled MIT-licensed .NET debugger.",
  "version": "0.0.3",
  "publisher": "local",
  "icon": "media/icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "workspaceContains:**/*.sln",
    "workspaceContains:**/*.slnx",
    "workspaceContains:**/*.csproj",
    "onLanguage:csharp",
    "onLanguage:razor",
    "onLanguage:aspnetcorerazor",
    "onDebugResolve:csharpshooter",
    "onDebugDynamicConfigurations:csharpshooter",
    "onDebugInitialConfigurations",
    "onDebugResolve:coreclr",
    "onDebugResolve:dotnet",
    "workspaceContains:**/[gG]ulpfile.js"
  ],
  "contributes": {
    "configuration": {
      "title": "CSharpShooter",
      "properties": {
        "csharpShooter.solution": {
          "type": "string",
          "default": "",
          "description": "Solution (.sln/.slnx) to load. Empty: the first one found in the workspace."
        },
        "csharpShooter.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to Microsoft.CodeAnalysis.LanguageServer.dll. Empty: the one under the extension's server/ folder."
        },
        "csharpShooter.debuggerPath": {
          "type": "string",
          "default": "",
          "description": "Path to the debug adapter (Passenger.DebugAdapter(.exe)). Empty: the one under the extension's debugger/ folder."
        },
        "csharpShooter.razorViewsInDesignTime": {
          "type": "boolean",
          "default": true,
          "description": "Give the language server's Razor every .cshtml even when a project sets RazorCompileOnBuild=false (only the server's design-time builds change; your builds don't)."
        },
        "csharpShooter.runMicrosoftConfigurations": {
          "type": "string",
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "default": "auto",
          "enumDescriptions": [
            "When the extension that owns the type (C# for coreclr, C# Dev Kit for dotnet) is not installed or is disabled.",
            "Always, even with Microsoft's extensions installed.",
            "Never: those configurations need Microsoft's debugger."
          ],
          "description": "Run launch.json configurations of type coreclr (Microsoft's C# extension) and dotnet (C# Dev Kit) on CSharpShooter's debugger."
        },
        "csharpShooter.taskRunner.projectOpenBindings": {
          "type": "boolean",
          "default": true,
          "description": "Start the tasks a gulpfile binds to Project Open (/// <binding ProjectOpened='...' />) as the workspace opens, as Visual Studio does. A task that .vscode/tasks.json already starts as the folder opens (runOn: folderOpen, the same gulp task in the same folder) is left to it, unless task.allowAutomaticTasks is off."
        },
        "csharpShooter.taskRunner.buildBindings": {
          "type": "boolean",
          "default": false,
          "description": "Run a gulpfile's Before Build, After Build and Clean bindings around CSharpShooter's builds (F5, Solution Explorer). Off by default: a project that runs gulp from its .csproj when built outside Visual Studio (BuildingInsideVisualStudio != true) would run it twice."
        },
        "csharpShooter.launchProfilesInLaunchJson": {
          "type": "string",
          "enum": [
            "ask",
            "always",
            "never"
          ],
          "default": "ask",
          "enumDescriptions": [
            "Ask once per workspace when launch.json lacks some of the projects' launch profiles.",
            "Add them without asking.",
            "Never add them (they stay under '.NET (CSharpShooter)...' in Select and Start Debugging)."
          ],
          "description": "Put the projects' launchSettings.json profiles (e.g. 'WebApp: WebApp Development') in .vscode/launch.json, so the Run and Debug dropdown lists them as Visual Studio's start button does. VS Code lists only launch.json's configurations there."
        },
        "csharpShooter.solutionSearch.fileContents": {
          "type": "boolean",
          "default": false,
          "description": "Solution Explorer's search also looks in the files' contents (ripgrep), as Visual Studio's 'Search within file contents'. Off by default, as there: only names."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "csharpShooter",
          "title": "Solution Explorer",
          "icon": "media/solution-explorer.svg"
        }
      ]
    },
    "views": {
      "csharpShooter": [
        {
          "type": "webview",
          "id": "csharpShooter.search",
          "name": "Wyszukaj",
          "initialSize": 1
        },
        {
          "id": "csharpShooter.solution",
          "name": "Solution Explorer",
          "icon": "media/solution-explorer.svg",
          "initialSize": 12
        },
        {
          "id": "csharpShooter.taskRunner",
          "name": "Eksplorator modułu uruchamiającego zadania",
          "icon": "$(checklist)",
          "initialSize": 6
        }
      ]
    },
    "submenus": [
      {
        "id": "csharpShooter.solution.add",
        "label": "Add"
      },
      {
        "id": "csharpShooter.taskRunner.bindings",
        "label": "Powiązania"
      }
    ],
    "commands": [
      {
        "command": "csharpShooter.restartServer",
        "title": "Restart C# Language Server",
        "category": "CSharpShooter"
      },
      {
        "command": "csharpShooter.solution.refresh",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "Solution"
      },
      {
        "command": "csharpShooter.solution.syncWithActive",
        "title": "Sync with Active Document",
        "icon": "$(target)",
        "category": "Solution"
      },
      {
        "command": "csharpShooter.solution.build",
        "title": "Build",
        "category": "Solution"
      },
      {
        "command": "csharpShooter.solution.rebuild",
        "title": "Rebuild",
        "category": "Solution"
      },
      {
        "command": "csharpShooter.solution.clean",
        "title": "Clean",
        "category": "Solution"
      },
      {
        "command": "csharpShooter.solution.editProject",
        "title": "Edit Project File",
        "category": "Solution"
      },
      {
        "command": "csharpShooter.solution.revealInOS",
        "title": "Open Folder in File Explorer",
        "category": "Solution"
      },
      {
        "command": "csharpShooter.solution.copyPath",
        "title": "Copy Full Path",
        "category": "Solution"
      },
      {
        "command": "csharpShooter.solution.openInTerminal",
        "title": "Open in Terminal",
        "category": "Solution"
      },
      {
        "command": "csharpShooter.solution.addFolder",
        "title": "New Folder...",
        "icon": "$(new-folder)",
        "category": "Solution"
      },
      {
        "command": "csharpShooter.solution.addView",
        "title": "View (.cshtml)...",
        "category": "Solution"
      },
      {
        "command": "csharpShooter.solution.addController",
        "title": "Controller (C#)...",
        "category": "Solution"
      },
      {
        "command": "csharpShooter.solution.debugProject",
        "title": "Start Debugging...",
        "icon": "$(debug-alt)",
        "category": "Solution"
      },
      {
        "command": "csharpShooter.taskRunner.refresh",
        "title": "Odśwież zadania",
        "category": "Eksplorator zadań",
        "icon": "$(refresh)"
      },
      {
        "command": "csharpShooter.taskRunner.run",
        "title": "Uruchom",
        "category": "Eksplorator zadań",
        "icon": "$(play)"
      },
      {
        "command": "csharpShooter.taskRunner.stop",
        "title": "Zatrzymaj",
        "category": "Eksplorator zadań",
        "icon": "$(debug-stop)"
      },
      {
        "command": "csharpShooter.taskRunner.bindBeforeBuild",
        "title": "Przed kompilacją",
        "category": "Eksplorator zadań"
      },
      {
        "command": "csharpShooter.taskRunner.bindAfterBuild",
        "title": "Po kompilacji",
        "category": "Eksplorator zadań"
      },
      {
        "command": "csharpShooter.taskRunner.bindClean",
        "title": "Oczyszczanie",
        "category": "Eksplorator zadań"
      },
      {
        "command": "csharpShooter.taskRunner.bindProjectOpened",
        "title": "Otwarcie projektu",
        "category": "Eksplorator zadań"
      },
      {
        "command": "csharpShooter.taskRunner.moveUp",
        "title": "Przenieś w górę",
        "icon": "$(arrow-up)",
        "category": "Eksplorator zadań"
      },
      {
        "command": "csharpShooter.taskRunner.moveDown",
        "title": "Przenieś w dół",
        "icon": "$(arrow-down)",
        "category": "Eksplorator zadań"
      },
      {
        "command": "csharpShooter.taskRunner.removeBinding",
        "title": "Usuń",
        "icon": "$(close)",
        "category": "Eksplorator zadań"
      },
      {
        "command": "csharpShooter.addLaunchProfiles",
        "title": "Add Launch Profiles to Run and Debug",
        "category": "CSharpShooter"
      },
      {
        "command": "csharpShooter.startup.setProject",
        "title": "Ustaw jako projekt startowy",
        "category": "CSharpShooter"
      },
      {
        "command": "csharpShooter.startup.pickProject",
        "title": "Projekt startowy...",
        "category": "CSharpShooter"
      },
      {
        "command": "csharpShooter.startup.menu",
        "title": "Profil uruchamiania...",
        "category": "CSharpShooter"
      },
      {
        "command": "csharpShooter.startup.start",
        "title": "Rozpocznij projekt startowy",
        "category": "CSharpShooter",
        "icon": "$(debug-start)"
      },
      {
        "command": "csharpShooter.startup.startWithoutDebugging",
        "title": "Uruchom projekt startowy bez debugowania",
        "category": "CSharpShooter",
        "icon": "$(run)"
      },
      {
        "command": "csharpShooter.solution.search",
        "title": "Search Solution Explorer",
        "icon": "$(search)",
        "category": "Solution"
      },
      {
        "command": "csharpShooter.searchEverywhere",
        "title": "Wyszukaj (kod, pliki, typy, elementy członkowskie, tekst, funkcje)",
        "icon": "$(search)",
        "category": "CSharpShooter"
      },
      {
        "command": "csharpShooter.findInFiles",
        "title": "Znajdź w plikach",
        "category": "CSharpShooter"
      },
      {
        "command": "csharpShooter.visualizeData",
        "title": "Wizualizator (DataTable, DataSet, IEnumerable)",
        "icon": "$(search)",
        "category": "CSharpShooter"
      },
      {
        "command": "csharpShooter.solution.publish",
        "title": "Opublikuj...",
        "category": "Solution"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "csharpShooter.searchEverywhere",
          "when": "view == csharpShooter.solution || view == csharpShooter.search",
          "group": "navigation@0"
        },
        {
          "command": "csharpShooter.solution.syncWithActive",
          "when": "view == csharpShooter.solution",
          "group": "navigation@1"
        },
        {
          "command": "csharpShooter.solution.refresh",
          "when": "view == csharpShooter.solution",
          "group": "navigation@2"
        },
        {
          "command": "csharpShooter.taskRunner.refresh",
          "when": "view == csharpShooter.taskRunner",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "csharpShooter.startup.setProject",
          "when": "view == csharpShooter.solution && viewItem =~ /^project runnable$/",
          "group": "0_debug@0"
        },
        {
          "submenu": "csharpShooter.solution.add",
          "when": "view == csharpShooter.solution && viewItem =~ /^(project|folder)( |$)/",
          "group": "0_add@1"
        },
        {
          "command": "csharpShooter.solution.debugProject",
          "when": "view == csharpShooter.solution && viewItem =~ /^project( |$)/",
          "group": "0_debug@1"
        },
        {
          "command": "csharpShooter.solution.build",
          "when": "view == csharpShooter.solution && viewItem =~ /^(solution|project)( |$)/",
          "group": "1_build@1"
        },
        {
          "command": "csharpShooter.solution.rebuild",
          "when": "view == csharpShooter.solution && viewItem =~ /^(solution|project)( |$)/",
          "group": "1_build@2"
        },
        {
          "command": "csharpShooter.solution.clean",
          "when": "view == csharpShooter.solution && viewItem =~ /^(solution|project)( |$)/",
          "group": "1_build@3"
        },
        {
          "command": "csharpShooter.solution.publish",
          "when": "view == csharpShooter.solution && viewItem =~ /^project( |$)/",
          "group": "1_build@4"
        },
        {
          "command": "csharpShooter.solution.editProject",
          "when": "view == csharpShooter.solution && viewItem =~ /^project( |$)/",
          "group": "2_edit@1"
        },
        {
          "command": "csharpShooter.solution.openInTerminal",
          "when": "view == csharpShooter.solution && viewItem =~ /^(solution|project|folder|file)( |$)/",
          "group": "3_open@1"
        },
        {
          "command": "csharpShooter.solution.revealInOS",
          "when": "view == csharpShooter.solution && viewItem =~ /^(solution|project|folder|file)( |$)/",
          "group": "3_open@2"
        },
        {
          "command": "csharpShooter.solution.copyPath",
          "when": "view == csharpShooter.solution && viewItem =~ /^(solution|project|folder|file)( |$)/",
          "group": "4_copy@1"
        },
        {
          "command": "csharpShooter.taskRunner.run",
          "when": "view == csharpShooter.taskRunner && viewItem =~ /^tr(Task|Script|Bound)( |$)/",
          "group": "inline@1"
        },
        {
          "command": "csharpShooter.taskRunner.stop",
          "when": "view == csharpShooter.taskRunner && viewItem =~ /^tr(Task|Script|Bound)\\.running/",
          "group": "inline@1"
        },
        {
          "command": "csharpShooter.taskRunner.moveUp",
          "when": "view == csharpShooter.taskRunner && viewItem =~ /^trBound.* up( |$)/",
          "group": "inline@2"
        },
        {
          "command": "csharpShooter.taskRunner.moveDown",
          "when": "view == csharpShooter.taskRunner && viewItem =~ /^trBound.* down( |$)/",
          "group": "inline@3"
        },
        {
          "command": "csharpShooter.taskRunner.removeBinding",
          "when": "view == csharpShooter.taskRunner && viewItem =~ /^trBound/",
          "group": "inline@4"
        },
        {
          "command": "csharpShooter.taskRunner.run",
          "when": "view == csharpShooter.taskRunner && viewItem =~ /^tr(Task|Script|Bound)( |$)/",
          "group": "1_run@1"
        },
        {
          "command": "csharpShooter.taskRunner.stop",
          "when": "view == csharpShooter.taskRunner && viewItem =~ /^tr(Task|Script|Bound)\\.running/",
          "group": "1_run@2"
        },
        {
          "submenu": "csharpShooter.taskRunner.bindings",
          "when": "view == csharpShooter.taskRunner && viewItem =~ /^trTask/",
          "group": "2_bind@1"
        },
        {
          "command": "csharpShooter.taskRunner.moveUp",
          "when": "view == csharpShooter.taskRunner && viewItem =~ /^trBound.* up( |$)/",
          "group": "2_bind@1"
        },
        {
          "command": "csharpShooter.taskRunner.moveDown",
          "when": "view == csharpShooter.taskRunner && viewItem =~ /^trBound.* down( |$)/",
          "group": "2_bind@2"
        },
        {
          "command": "csharpShooter.taskRunner.removeBinding",
          "when": "view == csharpShooter.taskRunner && viewItem =~ /^trBound/",
          "group": "2_bind@3"
        }
      ],
      "csharpShooter.solution.add": [
        {
          "command": "csharpShooter.solution.addFolder",
          "group": "1_folder@1"
        },
        {
          "command": "csharpShooter.solution.addView",
          "group": "2_items@1"
        },
        {
          "command": "csharpShooter.solution.addController",
          "group": "2_items@2"
        }
      ],
      "commandPalette": [
        {
          "command": "csharpShooter.solution.addFolder",
          "when": "false"
        },
        {
          "command": "csharpShooter.solution.addView",
          "when": "false"
        },
        {
          "command": "csharpShooter.solution.addController",
          "when": "false"
        },
        {
          "command": "csharpShooter.solution.build",
          "when": "false"
        },
        {
          "command": "csharpShooter.solution.rebuild",
          "when": "false"
        },
        {
          "command": "csharpShooter.solution.clean",
          "when": "false"
        },
        {
          "command": "csharpShooter.solution.editProject",
          "when": "false"
        },
        {
          "command": "csharpShooter.solution.revealInOS",
          "when": "false"
        },
        {
          "command": "csharpShooter.solution.copyPath",
          "when": "false"
        },
        {
          "command": "csharpShooter.solution.openInTerminal",
          "when": "false"
        },
        {
          "command": "csharpShooter.solution.debugProject",
          "when": "false"
        },
        {
          "command": "csharpShooter.taskRunner.run",
          "when": "false"
        },
        {
          "command": "csharpShooter.taskRunner.stop",
          "when": "false"
        },
        {
          "command": "csharpShooter.taskRunner.bindBeforeBuild",
          "when": "false"
        },
        {
          "command": "csharpShooter.taskRunner.bindAfterBuild",
          "when": "false"
        },
        {
          "command": "csharpShooter.taskRunner.bindClean",
          "when": "false"
        },
        {
          "command": "csharpShooter.taskRunner.bindProjectOpened",
          "when": "false"
        },
        {
          "command": "csharpShooter.taskRunner.moveUp",
          "when": "false"
        },
        {
          "command": "csharpShooter.taskRunner.moveDown",
          "when": "false"
        },
        {
          "command": "csharpShooter.taskRunner.removeBinding",
          "when": "false"
        },
        {
          "command": "csharpShooter.startup.setProject",
          "when": "false"
        },
        {
          "command": "csharpShooter.visualizeData",
          "when": "false"
        },
        {
          "command": "csharpShooter.solution.publish",
          "when": "false"
        }
      ],
      "csharpShooter.taskRunner.bindings": [
        {
          "command": "csharpShooter.taskRunner.bindBeforeBuild",
          "group": "1@1",
          "toggled": {
            "condition": "viewItem =~ / b:BeforeBuild( |$)/"
          }
        },
        {
          "command": "csharpShooter.taskRunner.bindAfterBuild",
          "group": "1@2",
          "toggled": {
            "condition": "viewItem =~ / b:AfterBuild( |$)/"
          }
        },
        {
          "command": "csharpShooter.taskRunner.bindClean",
          "group": "1@3",
          "toggled": {
            "condition": "viewItem =~ / b:Clean( |$)/"
          }
        },
        {
          "command": "csharpShooter.taskRunner.bindProjectOpened",
          "group": "1@4",
          "toggled": {
            "condition": "viewItem =~ / b:ProjectOpened( |$)/"
          }
        }
      ],
      "debug/variables/context": [
        {
          "command": "csharpShooter.visualizeData",
          "when": "debugType == 'csharpshooter' && variableType =~ /(^|\\.)(DataTable|DataSet|DataView)$|(^|\\.)(I?List|IEnumerable|I?ReadOnly(Collection|List)|I?Collection|ObservableCollection|HashSet|SortedSet|LinkedList|Queue|Stack|I?Dictionary|SortedDictionary|Immutable(Array|List))<.+>$|\\[\\]$/",
          "group": "inline"
        },
        {
          "command": "csharpShooter.visualizeData",
          "when": "debugType == 'csharpshooter' && variableType =~ /(^|\\.)(DataTable|DataSet|DataView)$|(^|\\.)(I?List|IEnumerable|I?ReadOnly(Collection|List)|I?Collection|ObservableCollection|HashSet|SortedSet|LinkedList|Queue|Stack|I?Dictionary|SortedDictionary|Immutable(Array|List))<.+>$|\\[\\]$/",
          "group": "navigation"
        }
      ],
      "debug/watch/context": [
        {
          "command": "csharpShooter.visualizeData",
          "when": "debugType == 'csharpshooter' && variableType =~ /(^|\\.)(DataTable|DataSet|DataView)$|(^|\\.)(I?List|IEnumerable|I?ReadOnly(Collection|List)|I?Collection|ObservableCollection|HashSet|SortedSet|LinkedList|Queue|Stack|I?Dictionary|SortedDictionary|Immutable(Array|List))<.+>$|\\[\\]$/",
          "group": "inline"
        },
        {
          "command": "csharpShooter.visualizeData",
          "when": "debugType == 'csharpshooter' && variableType =~ /(^|\\.)(DataTable|DataSet|DataView)$|(^|\\.)(I?List|IEnumerable|I?ReadOnly(Collection|List)|I?Collection|ObservableCollection|HashSet|SortedSet|LinkedList|Queue|Stack|I?Dictionary|SortedDictionary|Immutable(Array|List))<.+>$|\\[\\]$/",
          "group": "navigation"
        }
      ]
    },
    "breakpoints": [
      {
        "language": "csharp"
      },
      {
        "language": "razor"
      },
      {
        "language": "aspnetcorerazor"
      }
    ],
    "debuggers": [
      {
        "type": "csharpshooter",
        "label": ".NET (CSharpShooter)",
        "languages": [
          "csharp",
          "razor",
          "aspnetcorerazor"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [],
            "properties": {
              "program": {
                "type": "string",
                "description": "The app's .dll or apphost .exe; leave it out when 'project' is given."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "cwd": {
                "type": "string",
                "default": "${workspaceFolder}"
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "default": {}
              },
              "stopAtEntry": {
                "type": "boolean",
                "default": false
              },
              "justMyCode": {
                "type": "boolean",
                "default": true
              },
              "console": {
                "enum": [
                  "internalConsole",
                  "integratedTerminal",
                  "externalTerminal"
                ],
                "default": "internalConsole"
              },
              "hotReload": {
                "type": "boolean",
                "default": false
              },
              "project": {
                "type": "string",
                "description": "A .csproj to build and run: its program comes from MSBuild (TargetPath), as VS's F5."
              },
              "launchProfile": {
                "type": "string",
                "description": "A profile of the project's Properties/launchSettings.json: its environment, URLs (ASPNETCORE_URLS), arguments and browser. IISExpress profiles run on Kestrel at the IIS Express URLs."
              },
              "configuration": {
                "type": "string",
                "default": "Debug",
                "description": "Build configuration."
              },
              "build": {
                "type": "boolean",
                "default": true,
                "description": "Build the project before it starts."
              },
              "launchBrowser": {
                "type": "boolean",
                "default": true,
                "description": "Open the browser when a profile asks for it, once the app listens."
              },
              "startupProject": {
                "type": "boolean",
                "default": true,
                "description": "Run the startup project (status bar, Solution Explorer: Ustaw jako projekt startowy) with its active launch profile (its .csproj.user's ActiveDebugProfile, as Visual Studio keeps it), as VS's F5."
              },
              "framework": {
                "type": "string",
                "description": "Target framework of a multi-targeted project (its .csproj.user's ActiveDebugFramework for the startup project)."
              }
            }
          },
          "attach": {
            "required": [
              "processId"
            ],
            "properties": {
              "processId": {
                "type": [
                  "integer",
                  "string"
                ],
                "default": "${command:pickProcess}"
              },
              "justMyCode": {
                "type": "boolean",
                "default": true
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "name": "Launch project (CSharpShooter)",
            "type": "csharpshooter",
            "request": "launch",
            "project": "${workspaceFolder}/App/App.csproj",
            "launchProfile": "App"
          }
        ],
        "configurationSnippets": [
          {
            "label": ".NET: startup project (CSharpShooter)",
            "body": {
              "name": "Projekt startowy (CSharpShooter)",
              "type": "csharpshooter",
              "request": "launch",
              "startupProject": true
            }
          },
          {
            "label": ".NET: launch a project's profile (CSharpShooter)",
            "body": {
              "name": "${1:Project}: ${2:Profile}",
              "type": "csharpshooter",
              "request": "launch",
              "project": "^\"\\${workspaceFolder}/${1:Project}/${1:Project}.csproj\"",
              "launchProfile": "${2:Profile}"
            }
          }
        ]
      }
    ],
    "keybindings": [
      {
        "command": "csharpShooter.solution.search",
        "key": "ctrl+;",
        "mac": "cmd+;"
      },
      {
        "command": "csharpShooter.searchEverywhere",
        "key": "ctrl+t",
        "mac": "cmd+t"
      },
      {
        "command": "csharpShooter.findInFiles",
        "key": "ctrl+shift+f",
        "mac": "cmd+shift+f"
      }
    ],
    "languages": [
      {
        "id": "aspnetcorerazor",
        "aliases": [
          "ASP.NET Razor",
          "Razor"
        ],
        "extensions": [
          ".cshtml",
          ".razor"
        ],
        "configuration": "./syntaxes/aspnetcorerazor.language-configuration.json",
        "icon": {
          "light": "./media/razor.svg",
          "dark": "./media/razor.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "aspnetcorerazor",
        "scopeName": "text.aspnetcorerazor",
        "path": "./syntaxes/aspnetcorerazor.tmLanguage.json",
        "embeddedLanguages": {
          "source.cs": "csharp",
          "text.html.basic": "html",
          "source.css": "css",
          "source.js": "javascript"
        }
      }
    ],
    "configurationDefaults": {
      "files.associations": {
        "*.cshtml": "aspnetcorerazor",
        "*.razor": "aspnetcorerazor"
      },
      "[aspnetcorerazor]": {
        "editor.quickSuggestions": {
          "other": "on",
          "comments": "off",
          "strings": "on"
        }
      }
    }
