<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Test Explorer's way to VSTest: vstest.console driven through its own translation layer, as Visual Studio's Test
       Explorer drives it. Published into testbridge/out by scripts/build-testbridge.ps1 and started by test-engine.js. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.TestPlatform.TranslationLayer" Version="18.11.0" />
  </ItemGroup>
</Project>
